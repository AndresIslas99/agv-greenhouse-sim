<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="wlp0s20f3" priority="default" multicast="false" />
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <!-- MTU-safe sizing: WiFi MTU 1500 → max IPv4 UDP payload 1472. We
           leave 20-byte headroom for RTPS framing. Brain coordinated this
           so the pointcloud burst doesn't trigger IP fragmentation (which
           was overflowing the kernel ipfrag buffer and dropping samples). -->
      <MaxMessageSize>1452B</MaxMessageSize>
      <FragmentSize>1344B</FragmentSize>
    </General>

    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="localhost"/>
        <!-- Set to the Jetson brain's LAN IP for your deployment. -->
        <Peer address="JETSON_LAN_IP"/>
      </Peers>
    </Discovery>

    <Internal>
      <!-- 64 MB sockets so the kernel can absorb pointcloud bursts at
           ~32 Hz × ~11 MB/msg without dropping samples. Brain side runs
           the same 64 MB. -->
      <SocketReceiveBufferSize min="64MB" />
      <SocketSendBufferSize min="64MB" />
      <Watermarks>
        <!-- WhcHigh is the cap of the writer history cache (per reliable
             writer). The pointcloud is the dominant tenant; 8 MB lets it
             buffer ~1 sample without back-pressuring the publisher.
             WhcAdaptive lets Cyclone scale down for low-rate writers
             (joint_states, motor_state) so the smaller writers don't
             reserve the full 8 MB. -->
        <WhcHigh>8MB</WhcHigh>
        <WhcHighInit>1MB</WhcHighInit>
        <WhcAdaptive>true</WhcAdaptive>
      </Watermarks>
    </Internal>

    <Tracing>
      <OutputFile>/tmp/cyclonedds.log</OutputFile>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
