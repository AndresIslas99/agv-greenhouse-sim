<?xml version="1.0"?>
<!--
  Passive caster sphere. Exists only for Isaac PhysX chassis stability.
  The brain URDF has no casters — in HIL mode this link is unknown to the
  brain's robot_state_publisher and that is fine (no consumer references it).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="caster" params="name x y radius">
    <link name="${name}_caster">
      <visual>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="caster_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
      <inertial>
        <!-- Mass bumped from 0.1 → 1.0 kg to keep the PhysX mass ratio
             vs the 30 kg chassis at 30:1 (was 300:1, beyond the PhysX
             solver's stable range). Inertia scaled accordingly
             (sphere I = 2/5 m r², r=0.06: I ≈ 0.00144). At 300:1 the
             solver couldn't resolve the contact, producing a stick-slip
             "advance/brake" pattern visible in the viewport. -->
        <mass value="1.0"/>
        <inertia ixx="0.00144" ixy="0" ixz="0" iyy="0.00144" iyz="0" izz="0.00144"/>
      </inertial>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_caster"/>
      <!-- z = -(0.20 - radius) so the caster sphere is TANGENT to the
           wheel contact plane (wheel bottom is at base_link.z - 0.20).
           Without this, a larger caster radius would push the caster
           below the wheels and lift the drive wheels off the ground.
           Computed: -0.20 + radius. -->
      <origin xyz="${x} ${y} ${-0.20 + radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
